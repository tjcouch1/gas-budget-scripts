{
  "name": "gas-budget-scripts",
  "version": "1.0.0",
  "description": "Budgeting Google Apps Script project and web app workspace",
  "type": "module",
  "scripts": {
    "login": "pnpm --filter @budget/scripts-gas run login",
    "logout": "pnpm --filter @budget/scripts-gas run logout",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @budget/scripts-gas run start",
    "push": "pnpm --filter @budget/scripts-gas run push",
    "pull": "pnpm --filter @budget/scripts-gas run pull",
    "open": "pnpm --filter @budget/scripts-gas run open",
    "connect": "pnpm --filter @budget/scripts-gas run connect",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r run test:watch",
    "test:e2e": "pnpm --filter @budget/web run test:e2e",
    "demo": "pnpm --parallel --filter @budget/scripts-gas --filter @budget/web run demo",
    "test:coverage": "pnpm -r run test:coverage",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "TJ Couch",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.1"
  },
  "volta": {
    "node": "24.16.0",
    "pnpm": "10.34.5"
  },
  "private": true
}
