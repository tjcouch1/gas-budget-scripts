{
  "name": "@budget/web",
  "version": "1.0.0",
  "private": true,
  "description": "Fast Budget PWA: mobile-first frontend for the budgeting spreadsheet",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:licenses": "node scripts/generate-licenses.ts",
    "build": "pnpm run generate:licenses && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/generate-licenses.ts || echo license generation failed, the build will retry"
  },
  "author": "TJ Couch",
  "license": "MIT",
  "dependencies": {
    "@budget/shared": "workspace:*",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/license-checker": "25.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "license-checker": "25.0.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
