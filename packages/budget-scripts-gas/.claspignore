# clasp pushes from rootDir (./dist). Push matches these patterns relative to rootDir
# (e.g. `index.js`), while `clasp push --watch` matches relative to the project root
# (e.g. `dist/index.js`), so the whitelist must match both forms.

# Ignore all files by default
**/**

# Whitelist the bundled script and the appsscript manifest
!**/*.js
!**/appsscript.json
