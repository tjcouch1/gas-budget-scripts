{
  "name": "@budget/scripts-gas",
  "version": "1.0.0",
  "private": true,
  "description": "Google App Script test for budgeting",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "login": "clasp login",
    "logout": "clasp logout",
    "build": "node scripts/build.ts",
    "start": "node scripts/build.ts --watch --clasp",
    "push": "pnpm run build && clasp push",
    "pull": "clasp pull",
    "open": "clasp open",
    "connect": "clasp clone SCRIPT_PROJECT_ID --rootDir ./dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:server": "node scripts/dev-server.ts",
    "demo": "node scripts/dev-server.ts"
  },
  "author": "TJ Couch",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@budget/shared": "workspace:*"
  }
}
